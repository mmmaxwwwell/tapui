/* The RGB LED on PWM so the demo can dim it: three channels of pwm0 on the
 * LED's pins (all active low). The board puts pwm0 on P0.17 by default. */
&pinctrl {
	pwm0_rgb: pwm0_rgb {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			nordic,invert;
		};
	};

	pwm0_rgb_sleep: pwm0_rgb_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	pinctrl-0 = <&pwm0_rgb>;
	pinctrl-1 = <&pwm0_rgb_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	rgb_pwm {
		compatible = "pwm-leds";

		rgb_r: rgb_r {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};

		rgb_g: rgb_g {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};

		rgb_b: rgb_b {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
		};
	};
};
